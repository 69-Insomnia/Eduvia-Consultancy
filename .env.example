# Supabase project (Project Settings -> Database -> Connection string -> URI)
# Use the Session pooler URI (port 6543, username postgres.YOUR-REF): it has IPv4
# addresses and works on any machine. The direct host (db.YOUR-REF.supabase.co)
# is IPv6-only and fails with ENOTFOUND on IPv4-only networks.
SUPABASE_DB_URL=postgresql://postgres.YOUR-REF:password@aws-0-<region>.pooler.supabase.com:6543/postgres
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
# Comma-separated allowed browser origins for the Express API (same-origin in
# production; used only when an Origin header is sent).
CORS_ORIGIN=http://localhost:3000
SITE_URL=https://eduviaconsultancy.com
# Client-side canonical origin (inlined into browser bundles).
NEXT_PUBLIC_SITE_URL=https://eduviaconsultancy.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
NODE_ENV=development
