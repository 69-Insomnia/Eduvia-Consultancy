{
  "framework": "vite",
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://eduvia-api.onrender.com/api/:path*" },
    { "source": "/sitemap.xml", "destination": "https://eduvia-api.onrender.com/sitemap.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
